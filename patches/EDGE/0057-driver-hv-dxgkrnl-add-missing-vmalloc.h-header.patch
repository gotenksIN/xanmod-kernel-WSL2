 4 files changed, 4 insertions(+)

diff --git a/drivers/hv/dxgkrnl/dxgadapter.c b/drivers/hv/dxgkrnl/dxgadapter.c
index 6d3cabb24e6f3c9b1b60dc424906d6fa10f6c99a..0844ef064a4e3b8f0569ed5e4107ae2c6b3cdf10 100644
