 #include <linux/pagemap.h>
 #include <linux/eventfd.h>
+#include <linux/vmalloc.h>
 
 #include "dxgkrnl.h"
 
diff --git a/drivers/hv/dxgkrnl/dxgvmbus.c b/drivers/hv/dxgkrnl/dxgvmbus.c
